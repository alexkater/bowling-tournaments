# =============================================================================
# Dockerfile.api — reproducible multi-stage build for the Fastify + tRPC API
# =============================================================================

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
RUN corepack enable && corepack prepare pnpm@9.1.0 --activate
WORKDIR /app

FROM base AS builder

COPY pnpm-lock.yaml package.json turbo.json tsconfig.json ./
COPY infra/docker/pnpm-workspace.api.yaml ./pnpm-workspace.yaml
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/db/package.json packages/db/package.json
RUN pnpm install --frozen-lockfile --filter @bowling/api...
COPY . .
COPY infra/docker/pnpm-workspace.api.yaml ./pnpm-workspace.yaml
RUN pnpm --filter @bowling/shared exec tsc --project tsconfig.json
RUN pnpm --filter @bowling/db exec tsc --project tsconfig.json

# Production resolution must use compiled workspace output rather than TS source.
RUN node -e "const fs=require('fs'); \
  ['packages/shared','packages/db'].forEach(p => { \
    const pj=JSON.parse(fs.readFileSync(p+'/package.json','utf8')); \
    pj.exports['.'].import='./dist/index.js'; \
    pj.exports['.'].default='./dist/index.js'; \
    fs.writeFileSync(p+'/package.json',JSON.stringify(pj,null,2)); \
  });"

RUN pnpm --filter @bowling/api build

FROM base AS runner

# NEXT_PUBLIC_APP_URL is a runtime-only API setting injected by docker-compose.prod.yml.
ENV NODE_ENV=production

COPY --from=builder /app/package.json \
  /app/pnpm-lock.yaml \
  /app/pnpm-workspace.yaml \
  ./
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/packages/db/package.json ./packages/db/package.json

RUN pnpm install --frozen-lockfile --prod --filter @bowling/api...

COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/db/dist ./packages/db/dist
COPY --from=builder /app/packages/db/src ./packages/db/src
COPY --from=builder /app/packages/db/migrations ./packages/db/migrations
COPY --from=builder /app/packages/db/scripts ./packages/db/scripts
COPY --from=builder /app/packages/db/drizzle.config.ts ./packages/db/drizzle.config.ts
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/src ./apps/api/src

RUN addgroup --system --gid 1001 nodejs && \
  adduser --system --uid 1001 api && \
  chown -R api:nodejs /app

USER api
WORKDIR /app/apps/api

EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD node -e "require('node:http').get('http://127.0.0.1:3001/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["node", "--import", "tsx", "src/server.ts"]
